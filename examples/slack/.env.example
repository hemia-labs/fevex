# Leave the Slack values empty to start the browser simulator.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=

# Set to 1 to force simulator mode even when Slack values are present.
# FEVEX_SLACK_SIMULATE=1

# Optional external MCP server URL. It must expose an accounts_get tool with
# the same input schema as the local fixture.
# FEVEX_MCP_URL=https://example.com/mcp

# Optional real model for non-simulator mode. The browser simulator configures
# its model and key from the UI instead.
# FEVEX_PROVIDER=openai
# FEVEX_MODEL=
# OPENAI_API_KEY=
# FEVEX_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
