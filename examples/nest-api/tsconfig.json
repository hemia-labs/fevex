{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": "../..",
    "paths": {
      "@fevex/core/http": ["packages/fevex/src/http/index.ts"],
      "@fevex/core/runtime": ["packages/fevex/src/runtime/index.ts"],
      "@fevex/core/testing": ["packages/fevex/src/testing/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
