---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
---

<script is:inline>
  // Starlight stores Auto as an empty string; only a missing preference gets our default.
  try {
    if (localStorage.getItem('starlight-theme') === null) {
      localStorage.setItem('starlight-theme', 'dark');
    }
  } catch {
    // Storage can be unavailable; leave the native provider in control.
  }
</script>
<ThemeProvider />
