---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import Copy from "lucide-astro/Copy";
import Github from "lucide-astro/Github";
import Terminal from "lucide-astro/Terminal";
import Cpu from "lucide-astro/Cpu";
import Plug from "lucide-astro/Plug";
import Network from "lucide-astro/Network";
import Database from "lucide-astro/Database";
import Activity from "lucide-astro/Activity";
import Bot from "lucide-astro/Bot";
import Wrench from "lucide-astro/Wrench";
import Workflow from "lucide-astro/Workflow";
import Users from "lucide-astro/Users";
import History from "lucide-astro/History";
import Radio from "lucide-astro/Radio";
import ShieldCheck from "lucide-astro/ShieldCheck";
import Braces from "lucide-astro/Braces";
import FlaskConical from "lucide-astro/FlaskConical";
import LineChart from "lucide-astro/LineChart";
import MessageSquare from "lucide-astro/MessageSquare";

const GITHUB = "https://github.com/hemia-labs/fevex";
const copy = {
    metaDescription: "FEVEX is an open-source Agent Engineering Framework for production AI agents.",
    title: "FEVEX - Agent Engineering Framework for TypeScript",
    primaryNav: "Primary",
    home: "FEVEX home",
    docs: "Docs",
    examples: "Examples",
    adapters: "Adapters",
    integrations: "Integrations",
    roadmap: "Roadmap",
    cta: "Get Started",
    h1: "Agent Engineering Framework for TypeScript.",
    intro: "Build code-first, provider-neutral AI agents with typed tools, portable schemas, observable runs and small runtime contracts.",
    viewGithub: "View on GitHub",
    quickstartEyebrow: "Quick Start",
    quickstartTitle: "Start small. Stay portable.",
    quickstartNote: "Start with one typed agent. Add tools only when the workflow needs them.",
    codeFirstTitle: "Code first",
    codeFirstText: "Define agents and tools as typed TypeScript.",
    codeFirstNote: "Keep behavior explicit, reviewable and versionable.",
    providerTitle: "Provider agnostic",
    providerText: "Start with @fevex/core and add @fevex/openai or @fevex/deepseek only when needed.",
    providerNote: "Core contracts stay separate from models and infrastructure.",
    productionTitle: "Durable workflows",
    productionText: "Compose agents into workflows and teams that survive restarts.",
    productionNote: "Events make runs observable without owning a platform.",
    coreEyebrow: "Core API",
    coreTitle: "One typed API, end to end.",
    coreText: "Define agents, validate tools, connect any model and observe every run through one small API — with no runtime lock-in.",
    coreDocs: "Visit Documentation",
    coreSupports: "Adapters",
    coreMore: "+ more adapters",
    coreTabs: [
      ["Define agent", "agent.ts"],
      ["Type a tool", "tool.ts"],
      ["Connect a model", "model.ts"],
      ["Observe a run", "events.ts"],
    ] as const,
    capabilitiesTitle: "One framework for the agent system.",
    capabilitiesText: "FEVEX keeps the core pieces explicit, typed and portable — from a single agent to durable workflows and teams.",
    capabilities: ["Agents", "Tools", "Models", "Workflows", "Teams", "Sessions", "Streaming", "Approvals", "Events", "Schemas", "Evals", "Observability"],
    archEyebrow: "Architecture",
    archTitle: "One package. Explicit subpaths.",
    archText: "The core ships as a single package with public subpaths. Provider adapters are separate packages, so your app installs only what it uses.",
    archFlow: ["app code", "fevex runtime", "ModelGateway", "provider adapters"],
    archSubpaths: [
      ["@fevex/core", "Runtime, definitions and common contracts"],
      ["@fevex/core/agents", "Agent definitions"],
      ["@fevex/core/tools", "Tool definitions and execution context"],
      ["@fevex/core/models", "Provider-neutral ModelGateway contracts"],
      ["@fevex/core/workflows", "Durable workflow definitions"],
      ["@fevex/core/teams", "Multiagent team definitions"],
      ["@fevex/core/runtime", "Runs, sessions and store contracts"],
      ["@fevex/core/evals", "Datasets, scorers and regressions"],
      ["@fevex/core/testing", "Deterministic testing helpers"],
    ] as const,
    adaptersEyebrow: "Model Adapters",
    adaptersTitle: "Connect real model providers.",
    adaptersText: "Your app depends on the small ModelGateway contract. Official adapters implement it — they never execute tools, own retries or replace the runtime.",
    adaptersInstall: ["npm install @fevex/core @fevex/openai", "npm install @fevex/core @fevex/deepseek"],
    adaptersItems: ["@fevex/openai", "@fevex/deepseek", "custom ModelGateway"],
    integrationsEyebrow: "Integrations",
    integrationsTitle: "One runtime. Many surfaces.",
    integrationsText: "Fevex connects agents to model providers, remote tools and messaging channels through small explicit contracts.",
    integrationColumns: [
      { title: "Connections", status: "Available", desc: "Turn external systems into controlled tools with allowlists, schemas and events.", items: ["@fevex/mcp", "@fevex/openapi"] },
      { title: "Persistence & Traces", status: "Available", desc: "Durable runs and observability you plug in when production needs them.", items: ["@fevex/sqlite", "@fevex/postgres", "@fevex/opentelemetry"] },
      { title: "Channels", status: "Roadmap", desc: "Bring messages in and deliver responses back without the runtime knowing the surface.", items: ["Slack", "Discord", "WhatsApp", "Telegram"] },
    ] as const,
    integrationsNote: "Connections respect schemas, allowlists, approvals, cancellation and events. Channels normalize input and output; they never replace the runtime.",
    problemTitle: "The demo is not the hard part.",
    problemText: "Most agent prototypes break when prompts, tools, memory, workflows and logs become production responsibilities.",
    problemItems: ["Versionless prompts", "Unsafe tool calls", "Untested model calls", "Incomplete logs"],
    controlsTitle: "Validation at runtime boundaries.",
    controlsText: "Fevex validates what enters tools, what tools return, and what the agent returns to your app. If a schema cannot be represented for a model adapter, the run fails before touching the provider.",
    controlsItems: ["Standard Schema validation", "Portable JSON Schema 2020-12", "Tool events", "Run events"],
    eventsEyebrow: "Events",
    eventsTitle: "Observable runs, end to end.",
    eventsText: "Successful and failed runs emit structured events. Observe them with onEvent, or consume them incrementally with streamAgent.",
    eventNames: ["run.started", "model.completed", "tool.started", "tool.completed", "tool.failed", "run.completed", "run.failed", "run.cancelled"],
    examplesEyebrow: "Examples",
    examplesTitle: "Run real code.",
    examplesText: "Executable examples in the repo, from a local playground to HTTP and MCP servers.",
    examplesItems: [
      ["next-playground", "Web playground over the Fetch/SSE protocol.", `${GITHUB}/tree/main/examples/next-playground`],
      ["nest-api", "Real OpenAI/DeepSeek agent with sessions, cancellation and reconnection.", `${GITHUB}/tree/main/examples/nest-api`],
      ["nest-mcp", "Remote MCP tools under local allowlists.", `${GITHUB}/tree/main/examples/nest-mcp`],
    ] as const,
    useCasesEyebrow: "Use Cases",
    useCasesTitle: "A base for agent products.",
    useCasesText: "Fevex is the runtime; the product is yours.",
    useCasesItems: [
      ["Create-your-agent builders", "Use Fevex behind UIs where users configure instructions, tools, models and permissions."],
      ["Specialized agent catalogs", "Package support, sales, ops or developer agents as templates with explicit schemas."],
      ["Private agent platforms", "Publish internal agents over chat while Fevex keeps runs, events and permissions consistent."],
      ["Agent businesses", "Sell vertical agents without locking to one model provider or delivery channel."],
    ] as const,
    useCasesNote: "Builders, marketplaces and tenant management are products on top of Fevex, not part of the core package.",
    portableTitle: "Provider agnostic. Runtime portable.",
    portableText: "Start local, connect the model provider you need, and keep provider adapters outside the core.",
    portableItems: ["@fevex/openai", "@fevex/deepseek", "custom ModelGateway"],
    roadmapEyebrow: "Roadmap",
    roadmapTitle: "Ambition, honestly staged.",
    roadmapText: "What is shipped, what is next, and what is still planned.",
    roadmapRows: [
      ["Core MVP", "Done", "Local typed agents"],
      ["Portable schemas", "Done", "Runtime validation + adapter schemas"],
      ["OpenAI + DeepSeek", "Done", "Native provider adapters"],
      ["Loop + streaming", "Done", "Multi-step tasks and lifecycle events"],
      ["Sessions + durable runs", "Done", "Conversation, approvals and safe recovery"],
      ["Workflows + teams", "Done", "Durable orchestration and multiagent handoffs"],
      ["Connections", "Done", "MCP and OpenAPI tools"],
      ["Observability + evals", "Done", "Traces, cost and regression suites"],
      ["Channels", "Next", "Slack, Discord, WhatsApp and external surfaces"],
      ["Agent builder ecosystem", "Planned", "Templates, catalogs and products on top of Fevex"],
    ] as const,
    docsEyebrow: "Docs",
    docsTitle: "Start from the source.",
    docsText: "Until a docs site ships, these point to the README and repo.",
    docsLinks: [
      ["Quickstart", `${GITHUB}#quickstart`],
      ["Validation", `${GITHUB}#validation`],
      ["Events", `${GITHUB}#events`],
      ["Sessions", `${GITHUB}#sessions-and-consultable-runs`],
      ["Approvals", `${GITHUB}#approvals-and-durable-runs`],
      ["Workflows", `${GITHUB}#durable-workflows`],
      ["Teams", `${GITHUB}#advanced-teams`],
      ["Evaluations", `${GITHUB}#evaluations`],
      ["Observability", `${GITHUB}#observability`],
      ["Roadmap", `${GITHUB}/blob/main/docs/fevex_core_mvp_roadmap.md`],
    ] as const,
    footerTagline: "Open-source agent engineering for teams that need production behavior without platform lock-in.",
    footerProduct: "Product",
    footerDocs: "Docs",
    footerCommunity: "Community",
    footerProject: "Project",
    footerMade: "Built for production AI agents.",
};

const footerGroups = [
  {
    title: copy.footerProduct,
    links: [
      [copy.quickstartEyebrow, "#quickstart"],
      [copy.adapters, "#adapters"],
      [copy.integrations, "#integrations"],
      [copy.examples, "#examples"],
      [copy.roadmap, "#roadmap"],
    ],
  },
  {
    title: copy.footerDocs,
    links: [
      [copy.quickstartEyebrow, "#quickstart"],
      ["Validation", "#production"],
      ["Events", "#events"],
      [copy.docs, "#docs"],
    ],
  },
  {
    title: copy.footerCommunity,
    links: [
      ["GitHub", GITHUB],
      ["Issues", `${GITHUB}/issues`],
      ["Discussions", `${GITHUB}/discussions`],
    ],
  },
  {
    title: copy.footerProject,
    links: [
      ["License", `${GITHUB}/blob/main/LICENSE`],
      ["Contact", "mailto:hello@fevex.dev"],
    ],
  },
];

const quickstartCards = [
  [copy.codeFirstTitle, copy.codeFirstText, "npm i @fevex/core"],
  [copy.providerTitle, copy.providerText, "npm i @fevex/openai"],
  [copy.productionTitle, copy.productionText, "npm i @fevex/core"],
];

const capabilityIcons = [Bot, Wrench, Cpu, Workflow, Users, History, Radio, ShieldCheck, Activity, Braces, FlaskConical, LineChart];
const capGeo = { w: 1000, h: 760, cx: 500, cy: 380, coreHalf: 42, nodeHalf: 36, topY: 100, botY: 660, pad: 120 };
const capPerRow = Math.ceil(copy.capabilities.length / 2);
const capabilityNodes = copy.capabilities.map((label, i) => {
  const top = i < capPerRow;
  const idx = top ? i : i - capPerRow;
  const span = capGeo.w - capGeo.pad * 2;
  return {
    Icon: capabilityIcons[i] ?? Bot,
    label,
    top,
    x: capGeo.pad + span * (idx / (capPerRow - 1)),
    y: top ? capGeo.topY : capGeo.botY,
  };
});
const capLink = (n: { top: boolean; x: number; y: number }) => {
  const sy = n.top ? capGeo.cy - capGeo.coreHalf : capGeo.cy + capGeo.coreHalf;
  const ny = n.top ? n.y + capGeo.nodeHalf : n.y - capGeo.nodeHalf;
  const my = (sy + ny) / 2;
  return `M ${capGeo.cx} ${sy} C ${capGeo.cx} ${my} ${n.x} ${my} ${n.x} ${ny}`;
};

const adGeo = { w: 1000, h: 620, cx: 360, cy: 310, rOuter: 205, rInner: 158, nodeR: 26, labelX: 636 };
const adapterRows: string[][] = [
  ["OpenAI", "@fevex/openai"],
  ["DeepSeek", "@fevex/deepseek"],
  ["Custom", "ModelGateway"],
];
const integrationIcons = [Plug, Database, MessageSquare];

const problemGeo = { y: 104, startX: 205, endX: 795 };
const problemPoints = copy.problemItems.map((label, i, a) => ({
  label,
  x: problemGeo.startX + (problemGeo.endX - problemGeo.startX) * (i / (a.length - 1)),
}));

const flowStages = ["your app", "tool", "agent", "your app"];
const flowGates = ["tool input", "tool output", "final output"];
const flowStageX = (i: number) => 90 + 820 * (i / (flowStages.length - 1));
const flowGateX = (i: number) => (flowStageX(i) + flowStageX(i + 1)) / 2;

const eventsGeo = { y: 122, startX: 70, endX: 930 };
const eventPoints = copy.eventNames.map((name, i, a) => ({
  name,
  x: eventsGeo.startX + (eventsGeo.endX - eventsGeo.startX) * (i / (a.length - 1)),
  above: i % 2 === 0,
  ruby: /failed|cancelled/.test(name),
}));

const adAngles = [-52, 0, 52];
const adapterNodes = adapterRows.map((items, i) => {
  const a = (adAngles[i] * Math.PI) / 180;
  return {
    n: i + 1,
    items,
    x: adGeo.cx + adGeo.rOuter * Math.cos(a),
    y: adGeo.cy + adGeo.rOuter * Math.sin(a),
  };
});

const statusClass = (status: string) =>
  ["done", "hecho", "available", "disponible"].includes(status.toLowerCase())
    ? "is-done"
    : ["next", "siguiente"].includes(status.toLowerCase())
      ? "is-next"
      : "is-planned";

const heroPrimaryButton = buttonVariants({ size: "lg" });
const heroSecondaryButton = buttonVariants({ variant: "outline", size: "lg" });
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.metaDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{copy.title}</title>
  </head>
  <body>
    <nav class="topbar" aria-label={copy.primaryNav}>
      <a class="brand" href="/" aria-label={copy.home}>
        <img src="/brand/fevex-wordmark.svg" alt="FEVEX" />
      </a>
      <div class="nav-links">
        <a href="/docs">{copy.docs}</a>
        <a href="/adapter">{copy.adapters}</a>
        <a href="/integrations">{copy.integrations}</a>
        <a class="nav-icon" href={GITHUB} aria-label="GitHub">
          <Github size={20} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </nav>

    <main>
      <section class="hero">
        <div class="hero-pattern hero-pattern-left" aria-hidden="true">
          <span class="grid-node" style="--h: 64%; --v: 72%;">+</span>
          <span class="grid-node" style="--h: 46%; --v: 54%;">+</span>
          <span class="grid-node" style="--h: 78%; --v: 61%;">+</span>
          <span class="grid-node ruby" style="--h: 52%; --v: 82%;">+</span>
          <span class="grid-node" style="--h: 69%; --v: 48%;">+</span>
          <span class="grid-node" style="--h: 43%; --v: 76%;">+</span>
          <span class="grid-node" style="--h: 81%; --v: 57%;">+</span>
          <span class="grid-node" style="--h: 58%; --v: 87%;">+</span>
          <span class="grid-node ruby" style="--h: 74%; --v: 63%;">+</span>
          <span class="grid-node" style="--h: 49%; --v: 69%;">+</span>
        </div>

        <div class="hero-pattern hero-pattern-right" aria-hidden="true">
          <span class="grid-node" style="--h: 72%; --v: 56%;">+</span>
          <span class="grid-node" style="--h: 48%; --v: 83%;">+</span>
          <span class="grid-node ruby" style="--h: 86%; --v: 42%;">+</span>
          <span class="grid-node" style="--h: 61%; --v: 74%;">+</span>
          <span class="grid-node" style="--h: 39%; --v: 68%;">+</span>
          <span class="grid-node ruby" style="--h: 79%; --v: 47%;">+</span>
          <span class="grid-node" style="--h: 57%; --v: 88%;">+</span>
          <span class="grid-node" style="--h: 82%; --v: 58%;">+</span>
          <span class="grid-node ruby" style="--h: 64%; --v: 76%;">+</span>
          <span class="grid-node" style="--h: 88%; --v: 51%;">+</span>
          <span class="grid-node" style="--h: 44%; --v: 69%;">+</span>
          <span class="grid-node ruby" style="--h: 74%; --v: 84%;">+</span>
          <span class="grid-node" style="--h: 53%; --v: 61%;">+</span>
          <span class="grid-node" style="--h: 81%; --v: 45%;">+</span>
          <span class="grid-node ruby" style="--h: 46%; --v: 79%;">+</span>
          <span class="grid-node" style="--h: 69%; --v: 64%;">+</span>
          <span class="grid-node" style="--h: 84%; --v: 52%;">+</span>
          <span class="grid-node ruby" style="--h: 58%; --v: 86%;">+</span>
          <span class="grid-node" style="--h: 76%; --v: 59%;">+</span>
          <span class="grid-node" style="--h: 41%; --v: 72%;">+</span>
          <span class="spark" style="--x: 46%; --y: 24%; --size: 3px; --duration: 7.4s; --delay: -2.1s;"></span>
          <span class="spark" style="--x: 78%; --y: 36%; --size: 4px; --duration: 9.1s; --delay: -5.8s;"></span>
          <span class="spark" style="--x: 61%; --y: 57%; --size: 3px; --duration: 6.8s; --delay: -4.2s;"></span>
          <span class="spark" style="--x: 87%; --y: 72%; --size: 3px; --duration: 8.6s; --delay: -1.4s;"></span>
          <span class="spark" style="--x: 37%; --y: 84%; --size: 4px; --duration: 10.2s; --delay: -7.3s;"></span>
        </div>

        <div class="hero-content">
          <div class="copy">
            <h1>{copy.h1}</h1>
            <p class="intro">
              {copy.intro}
            </p>
            <div class="hero-install">
              <span class="prompt" aria-hidden="true">$</span>
              <code>npm install @fevex/core</code>
              <button class="install-copy" type="button" data-command="npm install @fevex/core" aria-label="Copy npm install @fevex/core">
                <Copy size={16} strokeWidth={1.8} aria-hidden="true" />
              </button>
            </div>
            <div class="actions">
              <a href="#quickstart" class={heroPrimaryButton}>{copy.cta}</a>
              <a href={GITHUB} class:list={[heroSecondaryButton, "secondary-button"]}>{copy.viewGithub}</a>
            </div>
          </div>
        </div>
      </section>

      <section id="quickstart" class="quickstart">
        <div class="quickstart-head">
          <div class="quickstart-copy">
            <div class="eyebrow">
              <span></span>
              <strong>{copy.quickstartEyebrow}</strong>
            </div>
            <h2>{copy.quickstartTitle}</h2>
            <div class="install">
              <Terminal size={24} strokeWidth={1.8} aria-hidden="true" />
              <code>npm install @fevex/core</code>
              <button class="install-copy" type="button" data-command="npm install @fevex/core" aria-label="Copy npm install @fevex/core">
                <Copy size={18} strokeWidth={1.8} aria-hidden="true" />
              </button>
            </div>
            <p class="section-lede">{copy.quickstartNote}</p>
          </div>
          <div class="code-window" aria-label="agent.ts">
            <div class="code-title">
              <i></i><i></i><i></i>
              <strong>agent.ts</strong>
              <button class="code-copy" type="button" aria-label="Copy code">
                <Copy size={16} strokeWidth={1.8} aria-hidden="true" />
              </button>
            </div>
            <pre><code><span>import</span> &#123; createFevex, defineAgent &#125; <span>from</span> "@fevex/core";
<span>import</span> &#123; createOpenAI &#125; <span>from</span> "@fevex/openai";

<span>const</span> openai = createOpenAI(&#123;
  apiKey: process.env.OPENAI_API_KEY!,
&#125;);

<span>const</span> app = createFevex(&#123;
  models: &#123; default: openai(<em>"gpt-5.6"</em>) &#125;,
  agents: [defineAgent(&#123;
    name: <em>"support"</em>,
    instructions: <em>"Answer clearly and briefly."</em>,
  &#125;)],
&#125;);

<span>const</span> result = <span>await</span> app.runAgent(<em>"support"</em>, &#123;
  input: <em>"How do I reset my API key?"</em>,
&#125;);</code></pre>
          </div>
        </div>
        <div class="feature-grid">
          {quickstartCards.map(([title, text, cmd]) => (
            <article class="ui-card qs-card">
              <h3>{title}</h3>
              <p>{text}</p>
              <div class="card-install">
                <span class="prompt" aria-hidden="true">$</span>
                <code>{cmd}</code>
                <button class="install-copy" type="button" data-command={cmd} aria-label={`Copy ${cmd}`}>
                  <Copy size={16} strokeWidth={1.8} aria-hidden="true" />
                </button>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="core" class="band split-band core-demo">
        <div class="core-copy">
          <div class="eyebrow">
            <span></span>
            <strong>{copy.coreEyebrow}</strong>
          </div>
          <h2>{copy.coreTitle}</h2>
          <p class="section-lede">{copy.coreText}</p>
          <a class:list={[heroSecondaryButton, "secondary-button"]} href={GITHUB}>{copy.coreDocs}</a>
          <div class="supports">
            <span class="supports-label">{copy.coreSupports}</span>
            <div class="supports-row">
              <span class="support-badge" title="OpenAI · DeepSeek"><Cpu size={18} strokeWidth={1.8} aria-hidden="true" /></span>
              <span class="support-badge" title="MCP"><Plug size={18} strokeWidth={1.8} aria-hidden="true" /></span>
              <span class="support-badge" title="OpenAPI"><Network size={18} strokeWidth={1.8} aria-hidden="true" /></span>
              <span class="support-badge" title="SQLite · Postgres"><Database size={18} strokeWidth={1.8} aria-hidden="true" /></span>
              <span class="support-badge" title="OpenTelemetry"><Activity size={18} strokeWidth={1.8} aria-hidden="true" /></span>
              <span class="supports-more">{copy.coreMore}</span>
            </div>
          </div>
        </div>
        <div class="code-tabs">
          <div class="code-tabs-nav" role="tablist" aria-label="Core API examples">
            {copy.coreTabs.map(([label], i) => (
              <button class:list={["code-tab", i === 0 && "is-active"]} type="button" data-tab={i} role="tab" aria-selected={i === 0 ? "true" : "false"}>{label}</button>
            ))}
          </div>
          <div class="code-window code-tabs-window" aria-label="agent.ts">
            <div class="code-title">
              <i></i><i></i><i></i>
              <strong class="code-tabs-filename">agent.ts</strong>
              <button class="code-tabs-copy" type="button" aria-label="Copy code">
                <Copy size={16} strokeWidth={1.8} aria-hidden="true" />
              </button>
            </div>
            <div class="code-panels">
              <pre class="code-panel is-active" data-panel="0" data-file="agent.ts"><code><span>import</span> &#123; createFevex, defineAgent &#125; <span>from</span> "@fevex/core";

<span>const</span> app = createFevex(&#123;
  models: &#123; default: model &#125;,
  agents: [defineAgent(&#123;
    name: <em>"support"</em>,
    instructions: <em>"Answer clearly and briefly."</em>,
  &#125;)],
&#125;);

<span>const</span> result = <span>await</span> app.runAgent(<em>"support"</em>, &#123;
  input: <em>"How do I reset my API key?"</em>,
&#125;);</code></pre>
              <pre class="code-panel" data-panel="1" data-file="tool.ts" hidden><code><span>import</span> &#123; defineTool &#125; <span>from</span> "@fevex/core";
<span>import</span> &#123; z &#125; <span>from</span> "zod";

<span>const</span> getAccount = defineTool(&#123;
  name: <em>"accounts_get"</em>,
  description: <em>"Get an account by ID."</em>,
  inputSchema: z.object(&#123; accountId: z.number() &#125;),
  outputSchema: z.object(&#123; status: z.literal(<em>"active"</em>) &#125;),
