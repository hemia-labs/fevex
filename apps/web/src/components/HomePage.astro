<script>
  const copyCommand = async (command: string) => {
    try {
      if (navigator.clipboard) {
        await navigator.clipboard.writeText(command);
        return;
      }
    } catch {
      // Clipboard API can reject without a trusted gesture; fall back below.
    }

    const textarea = document.createElement("textarea");
    textarea.value = command;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  };

  document.querySelectorAll<HTMLButtonElement>(".install-copy").forEach((button) => {
    const command = button.dataset.command;
    if (!command) return;

    button.addEventListener("click", async () => {
      await copyCommand(command);
      button.classList.add("is-copied");
      button.setAttribute("aria-label", "Copied");

      window.setTimeout(() => {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", `Copy ${command}`);
      }, 1600);
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".code-copy").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = button.closest(".code-window")?.querySelector("code");
      if (!code) return;

      await copyCommand(code.innerText);
      button.classList.add("is-copied");
      button.setAttribute("aria-label", "Copied");

      window.setTimeout(() => {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", "Copy code");
      }, 1600);
    });
  });

  document.querySelectorAll<HTMLElement>(".code-tabs").forEach((container) => {
    const tabs = container.querySelectorAll<HTMLButtonElement>(".code-tab");
    const panels = container.querySelectorAll<HTMLElement>(".code-panel");
    const filename = container.querySelector<HTMLElement>(".code-tabs-filename");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const index = tab.dataset.tab;

        tabs.forEach((other) => {
          const active = other === tab;
          other.classList.toggle("is-active", active);
          other.setAttribute("aria-selected", active ? "true" : "false");
        });

        panels.forEach((panel) => {
          const active = panel.dataset.panel === index;
          panel.classList.toggle("is-active", active);
          panel.hidden = !active;
          if (active && filename && panel.dataset.file) {
            filename.textContent = panel.dataset.file;
          }
        });
      });
    });

    const copyButton = container.querySelector<HTMLButtonElement>(".code-tabs-copy");
    copyButton?.addEventListener("click", async () => {
      const active = container.querySelector<HTMLElement>(".code-panel:not([hidden])");
      if (!active) return;

      await copyCommand(active.innerText);
      copyButton.classList.add("is-copied");
      copyButton.setAttribute("aria-label", "Copied");

      window.setTimeout(() => {
        copyButton.classList.remove("is-copied");
        copyButton.setAttribute("aria-label", "Copy code");
      }, 1600);
    });
  });
</script>
