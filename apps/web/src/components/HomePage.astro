  }

  .actions a:first-child:hover {
    background: color-mix(in oklab, var(--brand-ruby-red) 86%, black);
  }

  .band {
    padding: clamp(var(--space-64), 7vw, var(--space-96)) clamp(20px, 6vw, 88px);
    background: var(--brand-obsidian);
    color: var(--brand-warm-ivory);
    border-top: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 8%, transparent);
  }

  .band h2,
  .quickstart h2 {
    max-width: 760px;
    margin: 0 0 20px;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: 600;
    letter-spacing: 0;
  }

  .quickstart {
    position: relative;
    overflow: hidden;
    padding: clamp(var(--space-64), 9vw, var(--space-128)) clamp(var(--space-24), 6vw, var(--space-96)) var(--space-64);
    background: var(--brand-obsidian);
    color: var(--brand-warm-ivory);
  }

  .quickstart-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(440px, 1.05fr);
    gap: clamp(var(--space-32), 6vw, var(--space-64));
    align-items: start;
  }

  .quickstart-copy {
    padding-top: 8px;
  }

  .eyebrow {
    counter-increment: section;
    display: inline-flex;
    align-items: center;
    gap: var(--space-16);
    width: fit-content;
    margin-bottom: var(--space-24);
    color: color-mix(in oklab, var(--brand-warm-ivory) 58%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: counter(section, decimal-leading-zero);
    color: var(--brand-ruby-red);
    font-weight: 500;
  }

  .eyebrow span {
    display: inline-block;
    width: 32px;
    height: 1px;
    background: color-mix(in oklab, var(--brand-warm-ivory) 24%, transparent);
  }

  .eyebrow strong {
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .quickstart h2 {
    max-width: 820px;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: 600;
  }

  .install {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-16);
    width: min(100%, 560px);
    margin: var(--space-32) 0 var(--space-24);
    padding: 8px 8px 8px var(--space-24);
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 14%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 70%, var(--brand-graphite));
    color: var(--brand-warm-ivory);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: var(--text-code--line-height);
  }

  .section-lede {
    max-width: 760px;
    margin: 0 0 var(--space-32);
    color: color-mix(in oklab, var(--brand-warm-ivory) 62%, transparent);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .section-note {
    max-width: 760px;
    margin: var(--space-32) 0 0;
    color: color-mix(in oklab, var(--brand-warm-ivory) 50%, transparent);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
  }

  .install svg {
    color: var(--brand-ruby-red);
  }

  .install code {
    min-width: 0;
    color: var(--brand-warm-ivory);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 400;
    white-space: nowrap;
    overflow-x: auto;
  }

  .install-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in oklab, var(--brand-warm-ivory) 60%, transparent);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .install-copy:hover,
  .install-copy.is-copied {
    background: color-mix(in oklab, var(--brand-warm-ivory) 10%, transparent);
    color: var(--brand-warm-ivory);
  }

  .install-copy.is-copied {
    transform: translateY(-1px);
  }

  .install-copy.is-copied svg {
    opacity: 0;
  }

  .install-copy.is-copied::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--brand-ruby-red);
    border-bottom: 2px solid var(--brand-ruby-red);
    transform: translate(-50%, -60%) rotate(-45deg);
  }

  .install-copy svg {
    color: inherit;
  }

  .code-window {
    overflow: hidden;
    width: 100%;
    max-width: 536px;
    justify-self: end;
    border: 1px solid color-mix(in oklab, var(--brand-silver-mist) 22%, transparent);
    border-radius: calc(var(--radius) * 1.6);
    background: color-mix(in oklab, var(--brand-obsidian) 84%, var(--brand-graphite));
  }

  .quickstart .code-window {
    display: flex;
    flex-direction: column;
    min-height: 460px;
    max-width: none;
    justify-self: stretch;
  }

  .quickstart .code-window pre {
    flex: 1;
  }

  .quickstart .code-title {
    grid-template-columns: auto auto auto 1fr auto;
  }

  .code-title {
    display: grid;
    grid-template-columns: auto auto auto 1fr;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 var(--space-16);
    border-bottom: 1px solid color-mix(in oklab, var(--brand-silver-mist) 18%, transparent);
    color: var(--brand-silver-mist);
  }

  .code-title strong {
    margin-left: 8px;
    color: color-mix(in oklab, var(--brand-silver-mist) 84%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 400;
  }

  .code-title i {
    width: 9px;
    aspect-ratio: 1;
    border: 0;
    background: color-mix(in oklab, var(--brand-silver-mist) 34%, transparent);
    border-radius: 50%;
  }

  .code-title i:first-of-type {
    background: var(--brand-ruby-red);
  }

  .code-window pre {
    margin: 0;
    padding: var(--space-16);
    color: color-mix(in oklab, var(--brand-warm-ivory) 82%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.7;
    overflow-x: auto;
  }

  .code-window span {
    color: var(--brand-ruby-red);
  }

  .code-window em {
    color: var(--brand-silver-mist);
    font-style: normal;
  }

  /* Core API tabbed demo */
  .core-demo {
    align-items: center;
  }

  .core-copy .eyebrow {
    margin-bottom: var(--space-24);
  }

  .core-copy .secondary-button {
    margin-top: var(--space-8);
  }

  .supports {
    margin-top: var(--space-48);
  }

  .supports-label {
    display: block;
    margin-bottom: var(--space-16);
    color: color-mix(in oklab, var(--brand-warm-ivory) 52%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .supports-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .support-badge {
    display: grid;
    place-items: center;
    width: 40px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 14%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 78%, var(--brand-graphite));
    color: color-mix(in oklab, var(--brand-warm-ivory) 78%, transparent);
    transition: transform 220ms var(--ease-out-soft), border-color 220ms var(--ease-soft), color 220ms var(--ease-soft);
  }

  .support-badge:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--brand-warm-ivory) 30%, transparent);
    color: var(--brand-warm-ivory);
  }

  .supports-more {
    margin-left: 6px;
    color: color-mix(in oklab, var(--brand-warm-ivory) 52%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .code-tabs {
    min-width: 0;
  }

  .code-tabs-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: var(--space-16);
  }

  .code-tab {
    padding: 8px 14px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: color-mix(in oklab, var(--brand-warm-ivory) 56%, transparent);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 500;
    cursor: pointer;
    transition: background-color 200ms var(--ease-soft), color 200ms var(--ease-soft);
  }

  .code-tab:hover {
    color: var(--brand-warm-ivory);
  }

  .code-tab.is-active {
    color: var(--brand-warm-ivory);
    background: color-mix(in oklab, var(--brand-obsidian) 72%, var(--brand-graphite));
  }

  .code-tabs-window {
    max-width: none;
    justify-self: stretch;
  }

  .code-tabs-window .code-title {
    grid-template-columns: auto auto auto 1fr auto;
  }

  .code-tabs-copy,
  .code-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: color-mix(in oklab, var(--brand-silver-mist) 82%, transparent);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .code-tabs-copy:hover,
  .code-tabs-copy.is-copied,
  .code-copy:hover,
  .code-copy.is-copied {
    color: var(--brand-warm-ivory);
    border-color: color-mix(in oklab, var(--brand-warm-ivory) 18%, transparent);
  }

  .code-panels {
    position: relative;
  }

  .code-panel {
    margin: 0;
    padding: var(--space-16);
    color: color-mix(in oklab, var(--brand-warm-ivory) 82%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.7;
    overflow-x: auto;
    min-height: 268px;
  }

  .code-panel[hidden] {
    display: none;
  }

  .code-panel span {
    color: var(--brand-ruby-red);
  }

  .code-panel em {
    color: var(--brand-silver-mist);
    font-style: normal;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-16), 2.4vw, var(--space-32));
    max-width: none;
    margin: var(--space-64) 0 0;
  }

  .ui-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: var(--space-16);
    min-height: 220px;
    padding: var(--space-24);
    border-radius: calc(var(--radius) * 1.2);
    background: color-mix(in oklab, var(--brand-obsidian) 86%, var(--brand-graphite));
    color: var(--brand-warm-ivory);
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 12%, transparent);
    transition: transform 260ms var(--ease-out-soft), border-color 260ms var(--ease-soft), background-color 260ms var(--ease-soft);
  }

  .ui-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--brand-warm-ivory) 28%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 80%, var(--brand-graphite));
  }

  .card-heading {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .ui-card h3 {
    margin: 0;
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 500;
  }

  .ui-card p {
    margin: 0;
    color: var(--brand-silver-mist);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .ui-card strong {
    display: block;
    padding-top: var(--space-24);
    border-top: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 10%, transparent);
    align-self: end;
    color: var(--brand-warm-ivory);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    font-weight: 400;
  }

  .card-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    aspect-ratio: 1;
    color: color-mix(in oklab, var(--brand-warm-ivory) 74%, transparent);
  }

  .card-rule {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--brand-ruby-red);
  }

  .qs-card {
    grid-template-rows: auto 1fr auto;
  }

  .qs-card h3 {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
  }

  .card-install {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    margin-top: var(--space-16);
    padding: 8px 8px 8px var(--space-24);
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 14%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 70%, var(--brand-graphite));
    font-family: var(--font-mono);
    font-size: var(--text-code);
  }

  .card-install .prompt {
    flex-shrink: 0;
    color: color-mix(in oklab, var(--brand-warm-ivory) 55%, transparent);
  }

  .card-install code {
    flex: 1;
    min-width: 0;
    color: color-mix(in oklab, var(--brand-warm-ivory) 92%, transparent);
    overflow-x: auto;
    white-space: nowrap;
  }

  .card-install .install-copy {
    flex-shrink: 0;
  }

  .quickstart-mark {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-32);
    align-items: center;
    margin-top: var(--space-48);
  }

  .quickstart-mark::before,
  .quickstart-mark::after {
    content: "";
    height: 1px;
    background: color-mix(in oklab, var(--brand-warm-ivory) 12%, transparent);
  }

  .quickstart-mark img {
    width: 28px;
    height: auto;
  }

  .split-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
    gap: clamp(var(--space-32), 6vw, var(--space-96));
    align-items: start;
  }

  .pill-grid,
  .provider-row {
    display: grid;
    gap: 12px;
  }

  .pill-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .provider-row {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    max-width: 1100px;
  }

  .pill-grid span,
  .provider-row span,
  .stack-list span {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 15px 16px;
    border-radius: var(--radius);
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 10%, transparent);
    background: color-mix(in oklab, var(--brand-graphite) 18%, transparent);
    color: color-mix(in oklab, var(--brand-warm-ivory) 82%, transparent);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    transition: transform 220ms var(--ease-out-soft), border-color 220ms var(--ease-soft), background-color 220ms var(--ease-soft), color 220ms var(--ease-soft);
  }

  .pill-grid span:hover,
  .provider-row span:hover,
  .stack-list span:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--brand-warm-ivory) 26%, transparent);
    background: color-mix(in oklab, var(--brand-graphite) 30%, transparent);
    color: var(--brand-warm-ivory);
  }

  /* Capability diagram */
  .capability-diagram {
    margin-top: clamp(var(--space-48), 6vw, var(--space-96));
    overflow-x: auto;
  }

  .cap-canvas {
    position: relative;
    width: 100%;
    max-width: 960px;
    min-width: 640px;
    margin: 0 auto;
  }

  .cap-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cap-link {
    fill: none;
    stroke: color-mix(in oklab, var(--brand-warm-ivory) 20%, transparent);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .cap-core {
    position: absolute;
    display: grid;
    place-items: center;
    width: 200px;
    height: 84px;
    padding: 0 28px;
    transform: translate(-50%, -50%);
    border-radius: 20px;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 16%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 88%, var(--brand-graphite));
  }

  .cap-core img {
    width: 132px;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .cap-node {
    position: absolute;
    display: block;
    width: 72px;
    height: 72px;
    transform: translate(-50%, -50%);
  }

  .cap-node-card {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 18px;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 14%, transparent);
    background:
      linear-gradient(160deg,
        color-mix(in oklab, var(--brand-warm-ivory) 6%, transparent),
        transparent 45%),
      color-mix(in oklab, var(--brand-obsidian) 88%, var(--brand-graphite));
    color: color-mix(in oklab, var(--brand-warm-ivory) 84%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in oklab, var(--brand-warm-ivory) 14%, transparent);
    transition: border-color 220ms var(--ease-soft), color 220ms var(--ease-soft), transform 220ms var(--ease-out-soft);
  }

  .cap-node:hover .cap-node-card {
    border-color: color-mix(in oklab, var(--brand-ruby-red) 52%, transparent);
    color: var(--brand-warm-ivory);
    transform: translateY(-3px);
  }

  .cap-node-label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: color-mix(in oklab, var(--brand-warm-ivory) 62%, transparent);
    transition: color 220ms var(--ease-soft);
  }

  .cap-node.is-top .cap-node-label {
    bottom: calc(100% + 12px);
  }

  .cap-node.is-bottom .cap-node-label {
    top: calc(100% + 12px);
  }

  .cap-node:hover .cap-node-label {
    color: var(--brand-warm-ivory);
  }

  .stack-list {
    display: grid;
    gap: 12px;
  }

  /* Architecture */
  .arch-split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-32), 6vw, var(--space-96));
    align-items: start;
    margin-top: clamp(var(--space-32), 5vw, var(--space-64));
  }

  .arch-steps {
    display: flex;
    flex-direction: column;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arch-step {
    position: relative;
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: var(--space-24);
    align-items: center;
  }

  .arch-step:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 31px;
    top: 62px;
    width: 1px;
    height: 26px;
    background: color-mix(in oklab, var(--brand-warm-ivory) 26%, transparent);
  }

  .arch-step-num {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 32%, transparent);
    color: color-mix(in oklab, var(--brand-warm-ivory) 88%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    letter-spacing: 0.04em;
    transition: border-color 220ms var(--ease-soft), color 220ms var(--ease-soft);
  }

  .arch-step-label {
    color: color-mix(in oklab, var(--brand-warm-ivory) 82%, transparent);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .arch-step:hover .arch-step-num {
    border-color: var(--brand-ruby-red);
    color: var(--brand-ruby-red);
  }

  .subpath-table {
    display: grid;
    width: 100%;
    border-top: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 10%, transparent);
  }

  .subpath-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-24);
    align-items: center;
    padding: 18px 4px;
    border-bottom: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 10%, transparent);
  }

  .subpath-title {
    color: color-mix(in oklab, var(--brand-warm-ivory) 90%, transparent);
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 400;
    transition: color 200ms var(--ease-soft);
  }

  .subpath-row:hover .subpath-title {
    color: var(--brand-ruby-red);
  }

  .subpath-tag {
    justify-self: end;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 14%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 70%, var(--brand-graphite));
    color: color-mix(in oklab, var(--brand-warm-ivory) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
