---
import '@/styles/global.css';
import { Code } from 'astro:components';
import { buttonVariants } from '@/components/ui/button';
import AIThinkingGlobe from '@/components/AIThinkingGlobe.astro';
import ArrowUpRight from 'lucide-astro/ArrowUpRight';
import ArrowRight from 'lucide-astro/ArrowRight';
import Check from 'lucide-astro/Check';
import Copy from 'lucide-astro/Copy';
import Github from 'lucide-astro/Github';
import Menu from 'lucide-astro/Menu';
import Braces from 'lucide-astro/Braces';
import Network from 'lucide-astro/Network';
import Workflow from 'lucide-astro/Workflow';
import Terminal from 'lucide-astro/Terminal';
import Plug from 'lucide-astro/Plug';
import Database from 'lucide-astro/Database';
import Bot from 'lucide-astro/Bot';
import Wrench from 'lucide-astro/Wrench';
import Cpu from 'lucide-astro/Cpu';
import Users from 'lucide-astro/Users';
import History from 'lucide-astro/History';
import Radio from 'lucide-astro/Radio';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Activity from 'lucide-astro/Activity';
import FlaskConical from 'lucide-astro/FlaskConical';
import LineChart from 'lucide-astro/LineChart';

const github = 'https://github.com/hemia-labs/fevex';
const navigation = [
  ['Docs', '/docs/'], ['Adapters', '/docs/adapters/'],
  ['Integrations', '#integrations'], ['Examples', '#examples'],
];
const primaryButton = buttonVariants({ size: 'lg' });
const secondaryButton = buttonVariants({ variant: 'outline', size: 'lg' });
const examples = [
  {
    id: 'agent', label: 'Agent', file: 'agent.ts', note: 'Runs locally. No API key required.',
    code: `import { createFevex, defineAgent } from '@fevex/core';
import { fakeModel } from '@fevex/core/testing';

const app = createFevex({
  models: { default: fakeModel({ output: 'Hello from FEVEX.' }) },
  agents: [defineAgent({
    name: 'assistant',
    instructions: 'Be clear. Be helpful.',
  })],
});

const result = await app.runAgent('assistant', { input: 'Hello!' });
console.log(result.output); // Hello from FEVEX.`,
  },
  {
    id: 'tool', label: 'Tool', file: 'tool.ts', note: 'This example also uses Zod: npm install zod.',
    code: `import { defineTool } from '@fevex/core';
import { z } from 'zod';

export const getAccount = defineTool({
  name: 'accounts_get',
  description: 'Get an account by ID.',
  inputSchema: z.object({ accountId: z.number() }),
  outputSchema: z.object({
    accountId: z.number(), status: z.literal('active'),
  }),
  execute({ accountId }) {
    return { accountId, status: 'active' };
  },
});`,
  },
  {
    id: 'model', label: 'Model', file: 'model.ts', note: 'Add the provider package and your server-side API key.',
    code: `import { createOpenAI } from '@fevex/openai';
import { createDeepSeek } from '@fevex/deepseek';

const openai = createOpenAI({
  apiKey: process.env.OPENAI_API_KEY!,
});
const deepseek = createDeepSeek({
  apiKey: process.env.DEEPSEEK_API_KEY!,
});

// Choose a model ID supported by your provider.
export const models = {
  default: openai(process.env.OPENAI_MODEL!),
  alternative: deepseek(process.env.DEEPSEEK_MODEL!),
};`,
  },
  {
    id: 'events', label: 'Events', file: 'events.ts', note: 'A local example with observable lifecycle events.',
    code: `import { createFevex, defineAgent } from '@fevex/core';
import { fakeModel } from '@fevex/core/testing';

const app = createFevex({
  models: { default: fakeModel({ output: 'Hello from FEVEX.' }) },
  agents: [defineAgent({ name: 'assistant', instructions: 'Be helpful.' })],
  onEvent(event) {
    console.log(event.type);
  },
});

await app.runAgent('assistant', { input: 'Hello!' });
// run.started → model.started → … → run.completed`,
  },
];
const benefits = [
  { Icon: Braces, title: 'Typed by design.', text: 'Define agents and tools in TypeScript. Validate inputs and outputs at runtime.', href: '/docs/tools/', link: 'Explore typed tools' },
  { Icon: Network, title: 'Your choice of model.', text: 'One small contract for every provider. Add adapters without changing your application.', href: '/docs/models/', link: 'Meet ModelGateway' },
  { Icon: Workflow, title: 'Ready for the real work.', text: 'Compose workflows and teams. Add a persistent store for durable execution and recovery.', href: '/docs/workflows/', link: 'Explore workflows' },
];
const integrations = [
  { Icon: Network, title: 'Model providers', description: 'Connect the intelligence your agent needs.', packages: ['@fevex/openai', '@fevex/deepseek'], href: '/docs/adapters/' },
  { Icon: Plug, title: 'Tools & connections', description: 'Bring external systems into a controlled tool loop.', packages: ['@fevex/mcp', '@fevex/openapi'], href: '/docs/adapters/' },
  { Icon: Database, title: 'Persistence & traces', description: 'Keep runs durable and make execution observable.', packages: ['@fevex/sqlite', '@fevex/postgres', '@fevex/opentelemetry'], href: '/docs/adapters/' },
];
const projects = [
  { name: 'next-playground', category: 'WEB PLAYGROUND', description: 'A browser playground over the Fetch and SSE protocol.', label: 'Explore the playground' },
  { name: 'nest-api', category: 'HTTP API', description: 'Sessions, cancellation and reconnection with real model providers.', label: 'Explore the API' },
  { name: 'nest-mcp', category: 'REMOTE TOOLS', description: 'Connect remote MCP tools under explicit local allowlists.', label: 'Explore MCP tools' },
];
const footerGroups = [
  { title: 'Build', links: [['Quickstart', '/docs/quickstart/'], ['Agents & tools', '/docs/agents/'], ['Examples', '#examples']] },
  { title: 'Explore', links: [['Documentation', '/docs/'], ['Packages', '/docs/packages/'], ['Status & roadmap', '/docs/status/']] },
  { title: 'Community', links: [['GitHub', github], ['Discussions', `${github}/discussions`], ['License', `${github}/blob/main/LICENSE`]] },
];
const capabilities = ["Agents", "Tools", "Models", "Workflows", "Teams", "Sessions", "Streaming", "Approvals", "Events", "Schemas", "Evals", "Observability"];
const capabilityIcons = [Bot, Wrench, Cpu, Workflow, Users, History, Radio, ShieldCheck, Activity, Braces, FlaskConical, LineChart];
const capGeo = { w: 1000, h: 440, cx: 500, cy: 220, coreHalf: 42, nodeHalf: 36, topY: 72, botY: 368, pad: 120 };
const capPerRow = Math.ceil(capabilities.length / 2);
const capabilityNodes = capabilities.map((label, i) => {
  const top = i < capPerRow;
  const idx = top ? i : i - capPerRow;
  const span = capGeo.w - capGeo.pad * 2;
  return {
    Icon: capabilityIcons[i] ?? Bot,
    label,
    top,
    x: capGeo.pad + span * (idx / (capPerRow - 1)),
    y: top ? capGeo.topY : capGeo.botY,
  };
});
const capLink = (n: { top: boolean; x: number; y: number }) => {
  const sy = n.top ? capGeo.cy - capGeo.coreHalf : capGeo.cy + capGeo.coreHalf;
  const ny = n.top ? n.y + capGeo.nodeHalf : n.y - capGeo.nodeHalf;
  const my = (sy + ny) / 2;
  return `M ${capGeo.cx} ${sy} C ${capGeo.cx} ${my} ${n.x} ${my} ${n.x} ${ny}`;
};

const adGeo = { w: 1000, h: 620, cx: 360, cy: 310, rOuter: 205, rInner: 158, nodeR: 26, labelX: 636 };
const adapterRows: string[][] = [
  ["OpenAI", "@fevex/openai"],
  ["DeepSeek", "@fevex/deepseek"],
  ["Custom", "ModelGateway"],
];

const adAngles = [-52, 0, 52];
const adapterNodes = adapterRows.map((items, i) => {
  const a = (adAngles[i] * Math.PI) / 180;
  return {
    n: i + 1,
    items,
    x: adGeo.cx + adGeo.rOuter * Math.cos(a),
    y: adGeo.cy + adGeo.rOuter * Math.sin(a),
  };
});


---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Build typed, provider-neutral AI agents in TypeScript. FEVEX brings tools, durable workflows and observable runs into one open-source framework." />
    <meta name="theme-color" content="#020202" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://fevex.dev/" />
    <title>FEVEX — The Agentic Framework for TypeScript</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="FEVEX home"><img src="/brand/fevex-wordmark.svg" alt="FEVEX" width="136" height="24" /></a>
        <nav class="desktop-nav" aria-label="Primary">
          {navigation.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
        <div class="nav-actions">
          <a class="github-link" href={github} aria-label="FEVEX on GitHub"><Github size={19} aria-hidden="true" /></a>
          <a class="nav-cta" href="/docs/quickstart/">Get Started <ArrowUpRight size={14} aria-hidden="true" /></a>
          <details class="mobile-nav" data-mobile-nav>
            <summary aria-label="Navigation menu"><Menu size={21} aria-hidden="true" /></summary>
            <nav aria-label="Mobile navigation">
              {navigation.map(([label, href]) => <a href={href}>{label}<ArrowUpRight size={15} aria-hidden="true" /></a>)}
              <a href="/docs/quickstart/">Get Started <ArrowRight size={15} aria-hidden="true" /></a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">The agentic framework<br class="desktop-break" />{' '}for <span>TypeScript.</span></h1>
          <p class="hero-description">From your first agent to durable workflows.<br class="desktop-break" /> Typed tools, any model, and control over every run.</p>
          <div class="hero-actions">
            <a class:list={[primaryButton, 'action-primary']} href="/docs/quickstart/">Get Started <ArrowRight size={16} aria-hidden="true" /></a>
            <a class:list={[secondaryButton, 'action-secondary']} href={github}><Github size={17} aria-hidden="true" /> View on GitHub</a>
          </div>
          <div class="install-command">
            <span class="terminal-prompt" aria-hidden="true">$</span><code>npm install @fevex/core</code>
            <button type="button" class="copy-button icon-copy" data-copy="npm install @fevex/core" aria-label="Copy install command"><Copy size={15} aria-hidden="true" /><span class="copy-feedback" data-copy-label>Copy</span></button>
          </div>
        </div>
        <div class="hero-art" data-hero-motion><AIThinkingGlobe /></div>
        <div class="hero-footnote"><span>YOUR CODE. YOUR MODELS. YOUR INFRASTRUCTURE.</span><a href="#quickstart">See it in code <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="section container demo-section" id="quickstart" aria-labelledby="core">
        <div class="section-intro">
          <p class="eyebrow"><span>01</span> A SMALL API. A SOLID FOUNDATION.</p>
          <h2 id="core">Start small.<br /><span>Build from there.</span></h2>
          <p>Define an agent, give it a model, and run it. Add tools and infrastructure when your application needs them.</p>
          <a class="text-link" href="/docs/quickstart/">Open the full quickstart <ArrowUpRight size={16} aria-hidden="true" /></a>
          <div class="demo-facts"><span><Check size={14} aria-hidden="true" /> Deterministic local example</span><span><Check size={14} aria-hidden="true" /> No API key required</span></div>
        </div>
        <div class="code-demo" data-code-tabs>
          <div class="code-tabs" role="tablist" aria-label="TypeScript examples">
            {examples.map((example, i) => <button type="button" role="tab" id={`tab-${example.id}`} aria-controls={`panel-${example.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{example.label}</button>)}
          </div>
          {examples.map((example, i) => (
            <div role="tabpanel" id={`panel-${example.id}`} aria-labelledby={`tab-${example.id}`} tabindex="0" hidden={i !== 0}>
              <div class="code-toolbar"><span><Braces size={14} aria-hidden="true" />{example.file}</span><button class="copy-button" type="button" data-copy-target={`code-${example.id}`} aria-label={`Copy ${example.file}`}><Copy size={14} aria-hidden="true" /><span data-copy-label>Copy</span></button></div>
              <Code code={example.code} lang="ts" theme="css-variables" id={`code-${example.id}`} tabindex="0" aria-label={`${example.file} code`} />
              <p class="code-note">{example.note}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section container" id="capabilities" aria-labelledby="capabilities-heading">
        <div class="section-heading"><div><p class="eyebrow"><span>02</span> ENGINEERED TO FIT YOUR STACK</p><h2 id="capabilities-heading">Small contracts.<br /><span>Room to build.</span></h2></div><p>Keep behavior explicit, your models replaceable, and your application in control.</p></div>
        <div class="capability-diagram" role="group" aria-label="FEVEX framework capabilities">
          <div class="cap-canvas" style={`aspect-ratio:${capGeo.w} / ${capGeo.h}`}>
            <svg class="cap-lines" viewBox={`0 0 ${capGeo.w} ${capGeo.h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              {capabilityNodes.map((n) => (
                <path d={capLink(n)} class="cap-link" />
              ))}
            </svg>
            <div class="cap-core" style={`left:${(capGeo.cx / capGeo.w) * 100}%;top:${(capGeo.cy / capGeo.h) * 100}%`}>
              <img src="/brand/fevex-wordmark.svg" alt="FEVEX" />
            </div>
            {capabilityNodes.map(({ Icon, label, x, y, top }) => (
              <div
                class:list={["cap-node", top ? "is-top" : "is-bottom"]}
                style={`left:${(x / capGeo.w) * 100}%;top:${(y / capGeo.h) * 100}%`}
              >
                <span class="cap-node-card" aria-hidden="true">
                  <Icon size={24} strokeWidth={1.6} />
                </span>
                <span class="cap-node-label">{label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="benefit-grid">
          {benefits.map(({ Icon, title, text, href, link }) => (
            <article class="benefit">
              <div class="benefit-copy"><Icon size={19} strokeWidth={1.7} aria-hidden="true" /><h3>{title}</h3><p>{text}</p><a class="text-link" href={href}>{link}<ArrowUpRight size={15} aria-hidden="true" /></a></div>
            </article>
          ))}
        </div>
      </section>

      <section class="section container" id="integrations" aria-labelledby="adapters">
        <div class="section-heading"><div><p class="eyebrow"><span>03</span> AN OPEN ECOSYSTEM</p><h2 id="adapters">One core.<br /><span>Your connections.</span></h2></div><p>Install only what you need. Models, remote tools and persistence live in optional adapters.</p></div>
        <div class="adapter-diagram" role="group" aria-label="One ModelGateway connects OpenAI, DeepSeek and custom providers">
          <div class="ad-canvas" style={`aspect-ratio:${adGeo.w} / ${adGeo.h}`}>
            <svg class="ad-svg" viewBox={`0 0 ${adGeo.w} ${adGeo.h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <circle cx={adGeo.cx} cy={adGeo.cy} r={adGeo.rInner} class="ad-dash" />
              <path
                d={`M ${adGeo.cx} ${adGeo.cy - adGeo.rOuter} A ${adGeo.rOuter} ${adGeo.rOuter} 0 0 1 ${adGeo.cx} ${adGeo.cy + adGeo.rOuter}`}
                class="ad-arc"
              />
              <path
                d={`M ${adGeo.cx} ${adGeo.cy - adGeo.rOuter} C ${adGeo.cx - 78} ${adGeo.cy - adGeo.rOuter} ${adGeo.cx - 104} ${adGeo.cy - adGeo.rOuter + 34} ${adGeo.cx - 162} ${adGeo.cy - adGeo.rOuter + 20}`}
                class="ad-arc"
              />
              <circle cx={adGeo.cx - 162} cy={adGeo.cy - adGeo.rOuter + 20} r="4.5" class="ad-dot" />
              <path
                d={`M ${adGeo.cx} ${adGeo.cy + adGeo.rOuter} C ${adGeo.cx - 66} ${adGeo.cy + adGeo.rOuter} ${adGeo.cx - 92} ${adGeo.cy + adGeo.rOuter - 4} ${adGeo.cx - 128} ${adGeo.cy + adGeo.rOuter + 12}`}
                class="ad-arc"
              />
              <circle cx={adGeo.cx - 128} cy={adGeo.cy + adGeo.rOuter + 12} r="4.5" class="ad-dot" />
              {adapterNodes.map((node) => (
                <>
                  <line x1={node.x + adGeo.nodeR} y1={node.y} x2={adGeo.labelX - 18} y2={node.y} class="ad-conn" />
                  <circle cx={adGeo.labelX - 18} cy={node.y} r="4.5" class="ad-dot" />
                  <circle cx={node.x} cy={node.y} r={adGeo.nodeR} class="ad-node" />
                  <text x={node.x} y={node.y} class="ad-num" text-anchor="middle" dominant-baseline="central">{node.n}</text>
                </>
              ))}
            </svg>
            <div
              class="ad-core"
              style={`left:${(adGeo.cx / adGeo.w) * 100}%;top:${(adGeo.cy / adGeo.h) * 100}%`}
            >
              <strong>ONE GATEWAY</strong>
              <span>Any provider implements the same small contract</span>
            </div>
            {adapterNodes.map((node) => (
              <div
                class="ad-label"
                style={`left:${(adGeo.labelX / adGeo.w) * 100}%;top:${(node.y / adGeo.h) * 100}%`}
              >
                {node.items.map((it, i) => (
                  <>
                    {i > 0 && <span class="ad-sep" aria-hidden="true"></span>}
                    <span class:list={["ad-item", i === 0 && "is-lead"]}>{it}</span>
                  </>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="integration-grid">
          {integrations.map(({ Icon, title, description, packages, href }) => <article class="integration"><div class="integration-title"><Icon size={19} strokeWidth={1.6} aria-hidden="true" /><h3>{title}</h3></div><p>{description}</p><ul>{packages.map(name => <li><a href={href}><code>{name}</code><ArrowUpRight size={14} aria-hidden="true" /></a></li>)}</ul></article>)}
        </div>
        <div class="ecosystem-note" id="architecture"><span id="roadmap">Roadmap: messaging channels are next.</span><a class="text-link" href="/docs/status/">See status & scope <ArrowUpRight size={15} aria-hidden="true" /></a></div>
      </section>

      <section class="section container production-section" id="production" aria-labelledby="production-heading">
        <div class="section-intro"><p class="eyebrow"><span>04</span> BEYOND THE HAPPY PATH</p><h2 id="production-heading">Every boundary checked.<br /><span>Every run observable.</span></h2><p>Validate tool inputs and outputs. Follow lifecycle events, require approvals, and recover durable runs with a persistent store.</p><a class="text-link" href="/docs/workflows/">Explore durable execution <ArrowUpRight size={16} aria-hidden="true" /></a><a class="scope-note" href="/docs/status/">Early MVP · APIs may evolve <ArrowUpRight size={13} aria-hidden="true" /></a></div>
        <div class="execution-panel" id="events">
          <div class="execution-heading"><span class="ruby-dot" aria-hidden="true"></span><span>THE EXECUTION LIFECYCLE</span><span class="example-label">Example</span></div>
          <ol class="execution-flow">
            <li><span class="step-marker">01</span><div><strong>Start a run</strong><code>run.started</code></div><span class="step-note">Agent + input</span></li>
            <li><span class="step-marker">02</span><div><strong>Call the model</strong><code>model.completed</code></div><span class="step-note">Provider neutral</span></li>
            <li><span class="step-marker step-checked"><Check size={15} aria-hidden="true" /><span class="sr-only">03</span></span><div><strong>Validate & execute tools</strong><code>tool.completed</code></div><span class="step-note">Typed boundaries</span></li>
            <li><span class="step-marker step-checked"><Check size={15} aria-hidden="true" /><span class="sr-only">04</span></span><div><strong>Return a result</strong><code>run.completed</code></div><span class="step-note">Observable output</span></li>
          </ol>
          <p class="execution-footer">Failures and cancellations have their own events, too.</p>
        </div>
        <div class="validation-frame" role="group" aria-label="Runtime validation boundaries">
          <p class="frame-caption">VALIDATION BOUNDARIES</p>
          <ol class="validation-flow">
            {['Your app', 'Tool', 'Agent', 'Your app'].map((stage, i) => <li><span class="validation-stage">{stage}</span>{i < 3 && <span class="validation-gate"><Check size={18} aria-hidden="true" /><span>{['Tool input', 'Tool output', 'Final output'][i]}</span></span>}</li>)}
          </ol>
        </div>
      </section>

      <section class="section container" id="examples" aria-labelledby="examples-heading">
        <div class="section-heading"><div><p class="eyebrow"><span>05</span> FROM THE REPOSITORY</p><h2 id="examples-heading">Real code.<br /><span>A head start.</span></h2></div><a class="text-link" href={`${github}/tree/main/examples`}>Browse all examples <ArrowUpRight size={16} aria-hidden="true" /></a></div>
        <div class="example-grid">{projects.map(project => <a class="project-card" href={`${github}/tree/main/examples/${project.name}`}><div class="project-top"><Terminal size={20} aria-hidden="true" /><ArrowUpRight size={18} aria-hidden="true" /></div><span class="project-category">{project.category}</span><h3>{project.name}</h3><p>{project.description}</p><span class="project-link">{project.label}<ArrowRight size={15} aria-hidden="true" /></span></a>)}</div>
      </section>

      <section class="closing container" aria-labelledby="closing-heading"><span class="closing-cross" aria-hidden="true">+</span><p class="eyebrow">YOUR NEXT AGENT STARTS HERE</p><h2 id="closing-heading">Start with code.<br /><span>Make it yours.</span></h2><div class="hero-actions"><a class:list={[primaryButton, 'action-primary']} href="/docs/quickstart/">Get Started <ArrowRight size={16} aria-hidden="true" /></a><a class:list={[secondaryButton, 'action-secondary']} href={github}><Github size={17} aria-hidden="true" /> View on GitHub</a></div><p class="closing-note">Open source · Apache-2.0 · TypeScript</p></section>
    </main>

    <footer class="container site-footer" id="docs"><div class="footer-main"><div class="footer-brand"><a class="brand" href="/" aria-label="FEVEX home"><img src="/brand/fevex-wordmark.svg" alt="FEVEX" width="136" height="24" loading="lazy" /></a><p>Agent engineering.<br />On your terms.</p></div>{footerGroups.map(group => <div class="footer-group"><h2>{group.title}</h2>{group.links.map(([label, href]) => <a href={href}>{label}</a>)}</div>)}</div><div class="footer-bottom"><span>© {new Date().getFullYear()} FEVEX</span><span>Built for the builders.</span></div></footer>
    <p id="copy-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    <script>import '../scripts/landing';</script>
  </body>
</html>

<style>
  :global(html) { color-scheme: dark; scroll-padding-top: 92px; }
  :global(body) { margin: 0; -webkit-font-smoothing: antialiased; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  :global([hidden]) { display: none !important; }
  :global(.sr-only) { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  :global(::selection) { background: color-mix(in srgb, var(--brand-ruby-red) 38%, transparent); color: var(--brand-warm-ivory); }
  :global(a:focus-visible), :global(button:focus-visible), :global(summary:focus-visible), :global([tabindex]:focus-visible) { outline: 2px solid var(--brand-ruby-text); outline-offset: 5px; }
  .container { width: 100%; max-width: none; margin-inline: auto; }
  main > .container, .site-footer { border-inline: 1px solid var(--brand-border); }
  a { color: inherit; text-decoration: none; }
  button, summary { -webkit-tap-highlight-color: transparent; }
  button { cursor: pointer; font: inherit; }
