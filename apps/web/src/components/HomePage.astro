---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import Copy from "lucide-astro/Copy";
import Layers from "lucide-astro/Layers";
import ShieldCheck from "lucide-astro/ShieldCheck";
import Terminal from "lucide-astro/Terminal";

const { lang = "en" } = Astro.props as { lang?: "en" | "es" };
const copy = {
  en: {
    metaDescription: "FEVEX is an open-source Agent Engineering Framework for production AI agents.",
    title: "FEVEX - Agents built for production",
    primaryNav: "Primary",
    home: "FEVEX home",
    docs: "Docs",
    framework: "Framework",
    ecosystem: "Ecosystem",
    blog: "Blog",
    cta: "Get Started",
    h1: "Agents built",
    h1For: "for",
    h1Accent: "production.",
    intro: "FEVEX is the open framework for building, orchestrating and operating reliable AI agents.",
    readDocs: "Read Docs",
    quickstartEyebrow: "Quick Start",
    quickstartTitle: "Start small. Stay portable.",
    quickstartNote: "Add provider plugins only when the project actually needs them.",
    codeFirstTitle: "Code first",
    codeFirstText: "Define agents, tools and workflows as typed TypeScript.",
    codeFirstNote: "Keep behavior explicit, reviewable and versionable.",
    providerTitle: "Provider agnostic",
    providerText: "Start with fevex and add @fevex/* providers only when needed.",
    providerNote: "Core contracts stay separate from models and infrastructure.",
    productionTitle: "Production path",
    productionText: "Run locally first, then add durability when production needs it.",
    productionNote: "Persistence, observability and infrastructure stay opt-in.",
    problemTitle: "The demo is not the hard part.",
    problemText: "Most agent prototypes break when prompts, tools, memory, workflows and logs become production responsibilities.",
    problemItems: ["Versionless prompts", "Unsafe tool calls", "Manual evals", "Incomplete logs"],
    capabilitiesTitle: "One framework for the agent system.",
    capabilitiesText: "FEVEX keeps the core pieces explicit, typed and portable.",
    capabilities: ["Agents", "Models", "Tools", "Memory", "Workflows", "Policies", "Observability", "Evals"],
    controlsTitle: "Production controls from day one.",
    controlsText: "Timeouts, retries, permissions, traces, events, costs and evaluation hooks belong in the system, not in scattered glue code.",
    controlsItems: ["Guardrails and policies", "Auditable tool execution", "Traces, events and metrics", "Determinism where it matters"],
    portableTitle: "Provider agnostic. Runtime portable.",
    portableText: "Start local, connect the model provider you need, and keep the option to run on your own infrastructure or managed services.",
    portableItems: ["OpenAI", "Anthropic", "Google", "AWS Bedrock", "Azure OpenAI", "Local models"],
    footerTagline: "Open-source agent engineering for teams that need production behavior without platform lock-in.",
    footerProduct: "Product",
    footerResources: "Resources",
    footerCommunity: "Community",
    footerLegal: "Legal",
    footerInstall: "Install",
    footerDocs: "Documentation",
    footerExamples: "Examples",
    footerChangelog: "Changelog",
    footerGuides: "Guides",
    footerApi: "API Reference",
    footerBlog: "Blog",
    footerGithub: "GitHub",
    footerDiscussions: "Discussions",
    footerIssues: "Issues",
    footerLicense: "License",
    footerPrivacy: "Privacy",
    footerContact: "Contact",
    footerMade: "Built for production AI agents.",
  },
  es: {
    metaDescription: "FEVEX es un framework open source de ingeniería de agentes para agentes de IA en producción.",
    title: "FEVEX - Agentes listos para producción",
    primaryNav: "Principal",
    home: "Inicio de FEVEX",
    docs: "Docs",
    framework: "Framework",
    ecosystem: "Ecosistema",
    blog: "Blog",
    cta: "Comenzar",
    h1: "Agentes listos",
    h1For: "para",
    h1Accent: "producción.",
    intro: "FEVEX es el framework abierto para construir, orquestar y operar agentes de IA confiables.",
    readDocs: "Leer docs",
    quickstartEyebrow: "Quick Start",
    quickstartTitle: "Empieza pequeño. Sigue portable.",
    quickstartNote: "Agrega plugins de proveedores solo cuando el proyecto los necesite.",
    codeFirstTitle: "Código primero",
    codeFirstText: "Define agentes, tools y workflows como TypeScript tipado.",
    codeFirstNote: "Mantén el comportamiento explícito, revisable y versionable.",
    providerTitle: "Agnóstico de proveedor",
    providerText: "Empieza con fevex y agrega proveedores @fevex/* solo cuando hagan falta.",
    providerNote: "Los contratos core viven separados de modelos e infraestructura.",
    productionTitle: "Camino a producción",
    productionText: "Corre local primero, luego agrega durabilidad cuando producción lo pida.",
    productionNote: "Persistencia, observabilidad e infraestructura quedan opt-in.",
    problemTitle: "La demo no es la parte difícil.",
    problemText: "La mayoría de prototipos de agentes se rompen cuando prompts, herramientas, memoria, workflows y logs se vuelven responsabilidades de producción.",
    problemItems: ["Prompts sin versión", "Tools sin permisos", "Evals manuales", "Logs incompletos"],
    capabilitiesTitle: "Un framework para el sistema agentic.",
    capabilitiesText: "FEVEX mantiene las piezas core explícitas, tipadas y portables.",
    capabilities: ["Agents", "Models", "Tools", "Memory", "Workflows", "Policies", "Observability", "Evals"],
    controlsTitle: "Controles de producción desde día uno.",
    controlsText: "Timeouts, retries, permisos, trazas, eventos, costos y hooks de evaluación pertenecen al sistema, no a glue code disperso.",
    controlsItems: ["Guardrails y políticas", "Ejecución auditable de tools", "Traces, eventos y métricas", "Determinismo donde importa"],
    portableTitle: "Agnóstico de proveedor. Runtime portable.",
    portableText: "Empieza local, conecta el proveedor de modelos que necesites y conserva la opción de correr en infraestructura propia o administrada.",
    portableItems: ["OpenAI", "Anthropic", "Google", "AWS Bedrock", "Azure OpenAI", "Modelos locales"],
    footerTagline: "Ingeniería de agentes open source para equipos que necesitan comportamiento de producción sin lock-in de plataforma.",
    footerProduct: "Producto",
    footerResources: "Recursos",
    footerCommunity: "Comunidad",
    footerLegal: "Legal",
    footerInstall: "Instalación",
    footerDocs: "Documentación",
    footerExamples: "Ejemplos",
    footerChangelog: "Changelog",
    footerGuides: "Guías",
    footerApi: "Referencia API",
    footerBlog: "Blog",
    footerGithub: "GitHub",
    footerDiscussions: "Discusiones",
    footerIssues: "Issues",
    footerLicense: "Licencia",
    footerPrivacy: "Privacidad",
    footerContact: "Contacto",
    footerMade: "Construido para agentes de IA en producción.",
  },
}[lang];

const footerGroups = [
  {
    title: copy.footerProduct,
    links: [
      [copy.footerInstall, "#quickstart"],
      [copy.footerDocs, "#quickstart"],
      [copy.footerExamples, "#quickstart"],
      [copy.footerChangelog, "#quickstart"],
    ],
  },
  {
    title: copy.footerResources,
    links: [
      [copy.footerGuides, "#quickstart"],
      [copy.footerApi, "#quickstart"],
      [copy.footerBlog, "#quickstart"],
    ],
  },
  {
    title: copy.footerCommunity,
    links: [
      [copy.footerGithub, "https://github.com/fevex"],
      [copy.footerDiscussions, "https://github.com/fevex"],
      [copy.footerIssues, "https://github.com/fevex"],
    ],
  },
  {
    title: copy.footerLegal,
    links: [
      [copy.footerLicense, "https://github.com/fevex"],
      [copy.footerPrivacy, "mailto:hello@fevex.dev"],
      [copy.footerContact, "mailto:hello@fevex.dev"],
    ],
  },
];

const quickstartCards = [
  [Terminal, copy.codeFirstTitle, copy.codeFirstText, copy.codeFirstNote],
  [Layers, copy.providerTitle, copy.providerText, copy.providerNote],
  [ShieldCheck, copy.productionTitle, copy.productionText, copy.productionNote],
];

const primaryButton = buttonVariants();
const heroPrimaryButton = buttonVariants({ size: "lg" });
const heroSecondaryButton = buttonVariants({ variant: "outline", size: "lg" });
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.metaDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{copy.title}</title>
  </head>
  <body>
    <nav class="topbar" aria-label={copy.primaryNav}>
      <a class="brand" href={lang === "es" ? "/es/" : "/"} aria-label={copy.home}>
        <img src="/brand/fevex-wordmark.svg" alt="FEVEX" />
      </a>
      <div class="nav-links">
        <a href="#quickstart">{copy.docs}</a>
        <a href="#capabilities">{copy.framework}</a>
        <a href="#portable">{copy.ecosystem}</a>
        <a href="#quickstart">{copy.blog}</a>
        <a href="https://github.com/fevex">GitHub</a>
        <a href="/">EN</a>
        <a href="/es/">ES</a>
        <a class:list={[primaryButton, "nav-primary-button"]} href="#quickstart">{copy.cta}</a>
      </div>
    </nav>

    <main>
      <section class="hero">
        <div class="hero-pattern hero-pattern-left" aria-hidden="true">
          <span class="grid-node" style="--h: 64%; --v: 72%;">+</span>
          <span class="grid-node" style="--h: 46%; --v: 54%;">+</span>
          <span class="grid-node" style="--h: 78%; --v: 61%;">+</span>
          <span class="grid-node ruby" style="--h: 52%; --v: 82%;">+</span>
          <span class="grid-node" style="--h: 69%; --v: 48%;">+</span>
          <span class="grid-node" style="--h: 43%; --v: 76%;">+</span>
          <span class="grid-node" style="--h: 81%; --v: 57%;">+</span>
          <span class="grid-node" style="--h: 58%; --v: 87%;">+</span>
          <span class="grid-node ruby" style="--h: 74%; --v: 63%;">+</span>
          <span class="grid-node" style="--h: 49%; --v: 69%;">+</span>
        </div>

        <div class="hero-pattern hero-pattern-right" aria-hidden="true">
          <span class="grid-node" style="--h: 72%; --v: 56%;">+</span>
          <span class="grid-node" style="--h: 48%; --v: 83%;">+</span>
          <span class="grid-node ruby" style="--h: 86%; --v: 42%;">+</span>
          <span class="grid-node" style="--h: 61%; --v: 74%;">+</span>
          <span class="grid-node" style="--h: 39%; --v: 68%;">+</span>
          <span class="grid-node ruby" style="--h: 79%; --v: 47%;">+</span>
          <span class="grid-node" style="--h: 57%; --v: 88%;">+</span>
          <span class="grid-node" style="--h: 82%; --v: 58%;">+</span>
          <span class="grid-node ruby" style="--h: 64%; --v: 76%;">+</span>
          <span class="grid-node" style="--h: 88%; --v: 51%;">+</span>
          <span class="grid-node" style="--h: 44%; --v: 69%;">+</span>
          <span class="grid-node ruby" style="--h: 74%; --v: 84%;">+</span>
          <span class="grid-node" style="--h: 53%; --v: 61%;">+</span>
          <span class="grid-node" style="--h: 81%; --v: 45%;">+</span>
          <span class="grid-node ruby" style="--h: 46%; --v: 79%;">+</span>
          <span class="grid-node" style="--h: 69%; --v: 64%;">+</span>
          <span class="grid-node" style="--h: 84%; --v: 52%;">+</span>
          <span class="grid-node ruby" style="--h: 58%; --v: 86%;">+</span>
          <span class="grid-node" style="--h: 76%; --v: 59%;">+</span>
          <span class="grid-node" style="--h: 41%; --v: 72%;">+</span>
          <span class="spark" style="--x: 46%; --y: 24%; --size: 3px; --duration: 7.4s; --delay: -2.1s;"></span>
          <span class="spark" style="--x: 78%; --y: 36%; --size: 4px; --duration: 9.1s; --delay: -5.8s;"></span>
          <span class="spark" style="--x: 61%; --y: 57%; --size: 3px; --duration: 6.8s; --delay: -4.2s;"></span>
          <span class="spark" style="--x: 87%; --y: 72%; --size: 3px; --duration: 8.6s; --delay: -1.4s;"></span>
          <span class="spark" style="--x: 37%; --y: 84%; --size: 4px; --duration: 10.2s; --delay: -7.3s;"></span>
        </div>

        <div class="hero-content">
          <div class="copy">
            <h1>{copy.h1}<br />{copy.h1For} <span>{copy.h1Accent}</span></h1>
            <p class="intro">
              {copy.intro}
            </p>
            <div class="actions">
              <a href="#quickstart" class={heroPrimaryButton}>{copy.cta}</a>
              <a href="#quickstart" class:list={[heroSecondaryButton, "secondary-button"]}>{copy.readDocs}</a>
            </div>
          </div>
        </div>
      </section>

      <section id="quickstart" class="quickstart">
        <div class="quickstart-head">
          <div class="quickstart-copy">
            <div class="eyebrow">
              <span></span>
              <strong>{copy.quickstartEyebrow}</strong>
            </div>
            <h2>{copy.quickstartTitle}</h2>
            <div class="install">
              <Terminal size={24} strokeWidth={1.8} aria-hidden="true" />
              <code>npm install fevex</code>
              <Copy size={22} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <p class="section-lede">{copy.quickstartNote}</p>
          </div>
          <div class="code-window" aria-label="agent.ts">
            <div class="code-title">
              <span>&gt;_</span>
              <strong>agent.ts</strong>
              <i></i><i></i><i></i>
            </div>
            <pre><code><span>import</span> &#123; Agent &#125; <span>from</span> "fevex";
<span>import</span> &#123; openai &#125; <span>from</span> "@fevex/openai";

<span>const</span> agent = <span>new</span> Agent(&#123;
  name: <em>"researcher"</em>,
  model: openai(<em>"gpt-5-mini"</em>),
  tools: []
&#125;);</code></pre>
          </div>
        </div>
        <div class="feature-grid">
          {quickstartCards.map(([Icon, title, text, note]) => (
            <article class="ui-card">
              <div class="card-heading">
                <span class="card-icon" aria-hidden="true">
                  <Icon size={32} strokeWidth={1.8} />
                </span>
                <h3>{title}</h3>
              </div>
              <span class="card-rule" aria-hidden="true"></span>
              <p>{text}</p>
              <strong>{note}</strong>
            </article>
          ))}
        </div>
        <div class="quickstart-mark" aria-hidden="true">
          <img src="/brand/fevex-ruby-icon.svg" alt="" />
        </div>
      </section>

      <section id="problem" class="band split-band">
        <div>
          <h2>{copy.problemTitle}</h2>
          <p class="section-lede">{copy.problemText}</p>
        </div>
        <div class="pill-grid">
          {copy.problemItems.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section id="capabilities" class="band">
        <h2>{copy.capabilitiesTitle}</h2>
        <p class="section-lede">{copy.capabilitiesText}</p>
        <div class="capability-grid">
          {copy.capabilities.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section id="production" class="band split-band">
        <div>
          <h2>{copy.controlsTitle}</h2>
          <p class="section-lede">{copy.controlsText}</p>
        </div>
        <div class="stack-list">
          {copy.controlsItems.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section id="portable" class="band">
        <h2>{copy.portableTitle}</h2>
        <p class="section-lede">{copy.portableText}</p>
        <div class="provider-row">
          {copy.portableItems.map((item) => <span>{item}</span>)}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <a class="brand" href={lang === "es" ? "/es/" : "/"} aria-label={copy.home}>
          <img src="/brand/fevex-wordmark.svg" alt="FEVEX" />
        </a>
        <p>{copy.footerTagline}</p>
      </div>
      <div class="footer-links">
        {footerGroups.map((group) => (
          <section>
            <h2>{group.title}</h2>
            {group.links.map(([label, href]) => <a href={href}>{label}</a>)}
          </section>
        ))}
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} FEVEX.</span>
        <span>{copy.footerMade}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: var(--brand-warm-ivory);
    background: var(--brand-obsidian);
  }

  main {
    min-height: 100vh;
  }

  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(760px, calc(100svh - 72px));
    background: var(--brand-obsidian);
    color: var(--brand-warm-ivory);
  }

  .hero-pattern {
    position: absolute;
    display: grid;
    grid-template-rows: repeat(5, minmax(0, 1fr));
    pointer-events: none;
    animation: pattern-drift 16s ease-in-out infinite alternate;
  }

  .hero-pattern-left {
    inset: 7% auto 5% 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 38vw;
    opacity: 0.12;
    mask-image: linear-gradient(90deg, transparent, black 22%, black 58%, transparent);
  }

  .hero-pattern-right {
    inset: 7% 0 5% auto;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(58vw, 880px);
    mask-image: linear-gradient(90deg, transparent, black 24%, black 92%, transparent);
  }

  .grid-node {
    position: relative;
    color: color-mix(in oklab, var(--brand-warm-ivory) 76%, transparent);
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
  }

  .grid-node::before,
  .grid-node::after {
    content: "";
    position: absolute;
    top: 8px;
    left: 8px;
    background: currentColor;
    opacity: 0.2;
  }

  .grid-node::before {
    width: var(--h);
    height: 1px;
  }

  .grid-node::after {
    width: 1px;
    height: var(--v);
  }

  .grid-node.ruby {
    color: var(--brand-ruby-red);
    text-shadow: 0 0 12px color-mix(in oklab, var(--brand-ruby-red) 42%, transparent);
  }

  .grid-node.ruby::before,
  .grid-node.ruby::after {
    opacity: 0.58;
  }

  .spark {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand-ruby-red);
    box-shadow: 0 0 14px 3px color-mix(in oklab, var(--brand-ruby-red) 58%, transparent);
    opacity: 0;
    animation: ruby-flash var(--duration) linear var(--delay) infinite;
  }

  @keyframes pattern-drift {
    to {
      transform: translate3d(-8px, 6px, 0);
    }
  }

  @keyframes ruby-flash {
    0%, 78%, 100% {
      opacity: 0;
      transform: scale(0.6);
    }

    82% {
      opacity: 1;
      transform: scale(1.6);
    }

    85% {
      opacity: 0.18;
    }

    89% {
      opacity: 0.82;
      transform: scale(1.1);
    }

    92% {
      opacity: 0;
    }
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 72px;
    padding: 0 clamp(var(--space-24), 5vw, var(--space-64));
    border-bottom: 1px solid color-mix(in oklab, var(--brand-warm-ivory) 10%, transparent);
    background: color-mix(in oklab, var(--brand-obsidian) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    width: clamp(104px, 9vw, 136px);
    height: auto;
    filter: invert(96%) sepia(12%) saturate(351%) hue-rotate(343deg) brightness(103%) contrast(91%);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-16), 2.4vw, var(--space-32));
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
  }

  .nav-links a {
    color: color-mix(in oklab, var(--brand-warm-ivory) 78%, transparent);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--brand-warm-ivory);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: min(760px, calc(100svh - 72px));
    padding: clamp(var(--space-64), 10vw, var(--space-128)) clamp(var(--space-24), 12vw, var(--space-128));
  }

  .copy {
    max-width: 860px;
  }

  h1 {
    margin: 0;
    max-width: 760px;
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    font-weight: 600;
    letter-spacing: 0;
  }

  h1 span {
    color: var(--brand-ruby-red);
  }

  .hero h1 {
    max-width: 920px;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 600;
  }

  .intro {
    max-width: 500px;
    margin: var(--space-24) 0 0;
    color: color-mix(in oklab, var(--brand-warm-ivory) 72%, transparent);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--space-32);
  }

  .secondary-button {
    color: var(--brand-warm-ivory);
    background: transparent;
    border-color: color-mix(in oklab, var(--brand-warm-ivory) 22%, transparent);
  }

  .nav-primary-button {
    color: var(--brand-warm-ivory);
    background: var(--brand-ruby-red);
    border-color: var(--brand-ruby-red);
  }

  .band {
    padding: 56px clamp(20px, 6vw, 88px) 72px;
    background: var(--brand-obsidian);
    color: var(--brand-warm-ivory);
  }

  .band h2,
  .quickstart h2 {
    max-width: 760px;
    margin: 0 0 20px;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    font-weight: 600;
    letter-spacing: 0;
  }

  .quickstart {
    position: relative;
    overflow: hidden;
    padding: clamp(var(--space-64), 9vw, var(--space-128)) clamp(var(--space-24), 6vw, var(--space-96)) var(--space-64);
    background: var(--brand-obsidian);
    color: var(--brand-warm-ivory);
  }

  .quickstart-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.9fr);
    gap: clamp(var(--space-48), 8vw, var(--space-96));
    align-items: start;
  }

  .quickstart-copy {
    padding-top: 8px;
  }

  .eyebrow {
    display: grid;
    grid-template-columns: 64px auto;
    gap: var(--space-24);
    align-items: center;
    width: fit-content;
    margin-bottom: var(--space-32);
    color: var(--brand-ruby-red);
