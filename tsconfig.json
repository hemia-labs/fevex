      "@fevex/openai": ["packages/openai/src/index.ts"],
      "fevex/runtime": ["packages/fevex/src/runtime/index.ts"],
      "fevex/testing": ["packages/fevex/src/testing/index.ts"],
      "fevex/tools": ["packages/fevex/src/tools/index.ts"]
    }
  }
}
